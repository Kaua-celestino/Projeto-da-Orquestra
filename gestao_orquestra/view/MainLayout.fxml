<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gestao_orquestra.controller.MainLayoutController">
    <left>
        <VBox prefWidth="220.0" spacing="12.0" style="-fx-background-color: #1e293b;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Orquestra" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0" left="10.0" top="15.0" />
                    </VBox.margin>
                </Label>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirTelaMusicos" text="Músicos" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirTelaAcervo" text="Acervo / Instrumentos" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirTelaEmprestimos" text="Empréstimos" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirTelaConcertos" text="Concertos" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirTelaRelatorios" text="Relatórios / CSV" />

                <!-- Empurra o botão de sair para o rodapé do menu -->
                <Region VBox.vgrow="ALWAYS" />

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#sairDaConta" style="-fx-background-color: #ef4444; -fx-text-fill: white;" text="Sair da Conta" />
            </children>
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="conteudoCentral" prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Painel da Orquestra - Selecione uma opção no menu lateral">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
            </children>
        </StackPane>
    </center>
</BorderPane>