<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gestao_orquestra.controller.EmprestimosController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <children>
                <Label text="Gestão de Empréstimos">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <VBox spacing="10.0">
                    <children>
                        <HBox spacing="10.0">
                            <children>
                                <ComboBox fx:id="comboMusico" prefWidth="300.0" promptText="Selecionar Músico" />
                                <ComboBox fx:id="comboInstrumento" prefWidth="300.0" promptText="Selecionar Instrumento" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <DatePicker fx:id="dataRetiradaPicker" prefWidth="165.0" promptText="Data de Retirada" />
                                <DatePicker fx:id="dataPrevistaPicker" prefWidth="175.0" promptText="Devolução Prevista" />
                                <Button mnemonicParsing="false" onAction="#registrarEmprestimo" style="-fx-background-color: #22c55e; -fx-text-fill: white;" text="Registrar Empréstimo" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <TableView fx:id="tabelaEmprestimos" prefHeight="400.0" prefWidth="620.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colunaMusico" prefWidth="140.0" text="Músico" />
                        <TableColumn fx:id="colunaInstrumento" prefWidth="140.0" text="Instrumento" />
                        <TableColumn fx:id="colunaRetirada" prefWidth="90.0" text="Retirada" />
                        <TableColumn fx:id="colunaPrevista" prefWidth="95.0" text="Prev. Dev." />
                        <TableColumn fx:id="colunaDevolucao" prefWidth="85.0" text="Devolvido" />
                        <TableColumn fx:id="colunaStatus" prefWidth="70.0" text="Estado" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#calcularMulta" style="-fx-background-color: #f59e0b; -fx-text-fill: white;" text="Calcular Multa" />
                        <Button mnemonicParsing="false" onAction="#devolverEmprestimo" style="-fx-background-color: #3b82f6; -fx-text-fill: white;" text="Registrar Devolução" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>